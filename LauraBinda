                    ]
                  ),

                descripcion:
                  obtenerCampo(
                    propiedad,
                    [
                      "descripcion",
                      "descripción"
                    ]
                  )

              };

            }
          );


      construirFiltros();

      aplicarFiltros();

    }


    /* =========================================================
       CONSTRUIR FILTROS
    ========================================================= */

    function construirFiltros() {


      /*
       * AMBIENTES
       */

      const ambientes =
        state.properties

          .map(
            propiedad =>
              propiedad.ambientes
          )

          .filter(Boolean);


      state.environments =
        [
          ...new Set(
            ambientes.map(
              valor =>
                String(
                  valor
                ).trim()
            )
          )
        ];


      state.environments.sort(
        ordenarValores
      );


      elements.environmentButtons
        .innerHTML = "";


      elements.environmentButtons
        .appendChild(
          crearBotonAmbientes(
            "Todos",
            ""
          )
        );


      state.environments
        .forEach(
          ambiente => {

            elements.environmentButtons
              .appendChild(
                crearBotonAmbientes(
                  ambiente,
                  ambiente
                )
              );

          }
        );


      /*
       * BARRIOS
       */

      const barrios =
        state.properties

          .map(
            propiedad =>
              propiedad.barrio
          )

          .filter(Boolean);


      state.neighborhoods =
        [
          ...new Set(
            barrios
              .map(
                barrio =>
                  String(
                    barrio
                  ).trim()
              )
          )
        ];


      state.neighborhoods.sort(
        (a, b) =>
          a.localeCompare(
            b,
            "es",
            {
              sensitivity:
                "base"
            }
          )
      );


      elements.neighborhoodSelect
        .innerHTML =
        `
          <option value="">
            Todos los barrios
          </option>
        `;


      state.neighborhoods
        .forEach(
          barrio => {

            const option =
              document.createElement(
                "option"
              );


            option.value =
              barrio;


            option.textContent =
              barrio;


            elements.neighborhoodSelect
              .appendChild(
                option
              );

          }
        );

    }


    function ordenarValores(
      a,
      b
    ) {

      const na =
        parseFloat(
          String(a)
            .replace(",", ".")
        );


      const nb =
        parseFloat(
          String(b)
            .replace(",", ".")
        );


      if (
        !Number.isNaN(na) &&
        !Number.isNaN(nb)
      ) {

        return na - nb;

      }


      return String(a)
        .localeCompare(
          String(b),
          "es",
          {
            sensitivity:
              "base"
          }
        );

    }


    /* =========================================================
       BOTONES AMBIENTES
    ========================================================= */

    function crearBotonAmbientes(
      texto,
      valor
    ) {

      const button =
        document.createElement(
          "button"
        );


      button.type =
        "button";


      button.className =
        "environment-button";


      button.textContent =
        texto;


      if (
        state.selectedEnvironment ===
        valor
      ) {

        button.classList.add(
          "active"
        );

      }


      button.addEventListener(
        "click",
        () => {

          state.selectedEnvironment =
            valor;


          actualizarBotonesAmbientes();

          aplicarFiltros();

        }
      );


      return button;

    }


    function actualizarBotonesAmbientes() {

      document
        .querySelectorAll(
          ".environment-button"
        )

        .forEach(
          button => {

            const valor =
              button.dataset.value;


            button.classList.toggle(
              "active",
              valor ===
              state.selectedEnvironment
            );

          }
        );

    }


    /*
     * Corrección: guardar valor real
     */

    const crearBotonAmbientesOriginal =
      crearBotonAmbientes;


    /* =========================================================
       APLICAR DATA-VALUE
    ========================================================= */

    function prepararBotonesAmbientes() {

      document
        .querySelectorAll(
          ".environment-button"
        )
        .forEach(
          button => {

            if (
              button.textContent ===
              "Todos"
            ) {

              button.dataset.value =
                "";

            }

            else {

              button.dataset.value =
                button.textContent;

            }

          }
        );

    }


    /* =========================================================
       APLICAR FILTROS
    ========================================================= */

    function aplicarFiltros() {

      const ambienteSeleccionado =
        normalizarTexto(
          state.selectedEnvironment
        );


      const barrioSeleccionado =
        normalizarTexto(
          state.neighborhood
        );


      state.filteredProperties =
        state.properties.filter(
          propiedad => {


            /*
             * AMBIENTES
             */

            if (
              ambienteSeleccionado
            ) {

              const ambiente =
                normalizarTexto(
                  propiedad.ambientes
                );


              if (
                ambiente !==
                ambienteSeleccionado
              ) {

                return false;

              }

            }


            /*
             * BARRIO
             */

            if (
              barrioSeleccionado
            ) {

              const barrio =
                normalizarTexto(
                  propiedad.barrio
                );


              if (
                barrio !==
                barrioSeleccionado
              ) {

                return false;

              }

            }


            /*
             * PERRO
             */

            if (
              state.dog &&
              !esVerdadero(
                propiedad.perro
              )
            ) {

              return false;

            }


            /*
             * GATO
             */

            if (
              state.cat &&
              !esVerdadero(
                propiedad.gato
              )
            ) {

              return false;

            }


            /*
             * LAVARROPAS
             */

            if (
              state.laundry &&
              !esVerdadero(
                propiedad.lavado
              )
            ) {

              return false;

            }


            return true;

          }
        );


      renderizarPropiedades();

      actualizarContador();

    }


    /* =========================================================
       CONTADOR
    ========================================================= */

    function actualizarContador() {

      const cantidad =
        state.filteredProperties.length;


      if (cantidad === 1) {

        elements.resultsCount.textContent =
          "1 departamento encontrado";

      }

      else {

        elements.resultsCount.textContent =
          `${cantidad} departamentos encontrados`;

      }

    }


    /* =========================================================
       RENDER
    ========================================================= */

    function renderizarPropiedades() {

      elements.propertiesContainer
        .innerHTML = "";


      if (
        state.filteredProperties.length ===
        0
      ) {

        mostrarEmpty();

        return;

      }


      state.filteredProperties
        .forEach(
          (propiedad, index) => {

            elements.propertiesContainer
              .appendChild(
                crearTarjeta(
                  propiedad,
                  index
                )
              );

          }
        );

    }


    /* =========================================================
       CREAR TARJETA
    ========================================================= */

    function crearTarjeta(
      propiedad,
      index
    ) {

      const card =
        document.createElement(
          "article"
        );


      card.className =
        "property-card";


      /* =====================================================
         IMAGEN
      ===================================================== */

      const imageContainer =
        document.createElement(
          "div"
        );


      imageContainer.className =
        "property-image-container";


      /*
       * DISPONIBILIDAD
       */

      if (
        propiedad.disponibilidad
      ) {

        const badge =
          document.createElement(
            "div"
          );


        badge.className =
          "image-badge available";


        badge.textContent =
          propiedad.disponibilidad;


        imageContainer.appendChild(
          badge
        );

      }


      /*
       * IMAGEN
       */

      if (
        propiedad.fotos.length > 0
      ) {

        const img =
          document.createElement(
            "img"
          );


        img.className =
          "property-image";


        img.src =
          propiedad.fotos[0];


        img.alt =
          `Departamento en ${
            propiedad.barrio ||
            "alquiler"
          }`;


        img.loading =
          index < 3
            ? "eager"
            : "lazy";


        img.decoding =
          "async";


        img.onerror =
          () => {

            img.style.display =
              "none";


            const placeholder =
              document.createElement(
                "div"
              );


            placeholder.className =
              "property-image-placeholder";


            placeholder.innerHTML =
              `
                <div style="font-size:36px">
                  🏠
                </div>

                <div>
                  Imagen no disponible
                </div>
              `;


            imageContainer
              .appendChild(
                placeholder
              );

          };


        img.addEventListener(
          "click",
          () => {

            abrirGaleria(
              propiedad.fotos,
              0
            );

          }
        );


        imageContainer.appendChild(
          img
        );


        /*
         * CANTIDAD DE FOTOS
         */

        if (
          propiedad.fotos.length > 1
        ) {

          const photosBadge =
            document.createElement(
              "div"
            );


          photosBadge.className =
            "photos-badge";


          photosBadge.textContent =
            `📷 ${
              propiedad.fotos.length
            } fotos`;


          imageContainer
            .appendChild(
              photosBadge
            );

        }

      }

      else {

        imageContainer.innerHTML =
          `
            <div
              class="property-image-placeholder"
            >

              <div style="font-size:36px">
                🏠
              </div>

              <div>
                Sin imágenes
              </div>

            </div>
          `;

      }


      card.appendChild(
        imageContainer
      );


      /* =====================================================
         CONTENT
      ===================================================== */

      const content =
        document.createElement(
          "div"
        );


      content.className =
        "property-content";


      /*
       * BARRIO
       */

      if (
        propiedad.barrio
      ) {

        const location =
          document.createElement(
            "div"
          );


        location.className =
          "property-location";


        location.innerHTML =
          `
            <span>📍</span>

            <span>
              ${escaparHTML(
                propiedad.barrio
              )}
            </span>
          `;


        content.appendChild(
          location
        );

      }


      /*
       * TITULO
       */

      const title =
        document.createElement(
          "h2"
        );


      title.className =
        "property-title";


      if (
        propiedad.ambientes
      ) {

        const ambiente =
          propiedad.ambientes;


title.textContent =
  normalizarTexto(ambiente).includes("amb")
    ? ambiente
    : (
        normalizarTexto(ambiente) === "1"
          ? "1 ambiente"
          : `${ambiente} ambientes`
      );

      }

      else {

        title.textContent =
          "Departamento";

      }


      content.appendChild(
        title
      );


      /*
       * DIRECCIÓN
       */

      if (
        propiedad.direccion
      ) {

        const address =
          document.createElement(
            "div"
          );


        address.className =
          "property-address";


        address.textContent =
          `📍 ${
            propiedad.direccion
          }`;


        content.appendChild(
          address
        );

      }


      /*
       * PRECIO
       */

      const price =
        document.createElement(
          "div"
        );


      price.className =
        "property-price";


      price.innerHTML =
        `
          <div>

            <div class="price-label">
              Valor mensual
            </div>

          </div>

          <div class="price-value">
            ${escaparHTML(
              formatearPrecio(
                propiedad.valor
              )
            )}
          </div>
        `;


      content.appendChild(
        price
      );


      /*
       * EXPENSAS / GASTOS
       */

      if (
        propiedad.expensas ||
        propiedad.gastos
      ) {

        const costs =
          document.createElement(
            "div"
          );


        costs.className =
          "property-costs";


        if (
          propiedad.expensas
        ) {

          costs.innerHTML +=
            `
              <div class="cost-box">

                <span class="cost-label">
                  Expensas
                </span>

                <span class="cost-value">
                  ${escaparHTML(
                    propiedad.expensas
                  )}
                </span>

              </div>
            `;

        }


        if (
          propiedad.gastos
        ) {

          costs.innerHTML +=
            `
              <div class="cost-box">

                <span class="cost-label">
                  Gastos
                </span>

                <span class="cost-value">
                  ${escaparHTML(
                    propiedad.gastos
                  )}
                </span>

              </div>
            `;

        }


        content.appendChild(
          costs
        );

      }


      /*
       * AMENITIES
       */

      const amenities = [];


      if (
        esVerdadero(
          propiedad.perro
        )
      ) {

        amenities.push(
          "🐶 Apto perro"
        );

      }


      if (
        esVerdadero(
          propiedad.gato
        )
      ) {

        amenities.push(
          "🐱 Apto gato"
        );

      }


      if (
        esVerdadero(
          propiedad.lavado
        )
      ) {

        amenities.push(
          "🧺 Lavarropas"
        );

      }


      if (
        amenities.length > 0
      ) {

        const amenitiesContainer =
          document.createElement(
            "div"
          );


        amenitiesContainer.className =
          "property-amenities";


        amenities.forEach(
          amenity => {

            const chip =
              document.createElement(
                "span"
              );


            chip.className =
              "amenity-chip";


            chip.textContent =
              amenity;


            amenitiesContainer
              .appendChild(
                chip
              );

          }
        );


        content.appendChild(
          amenitiesContainer
        );

      }


      /*
       * DESCRIPCIÓN
       */

      if (
        propiedad.descripcion
      ) {

        const descriptionButton =
          document.createElement(
            "button"
          );


        descriptionButton.type =
          "button";


        descriptionButton.className =
          "description-button";


        descriptionButton.innerHTML =
          `
            <span>📄</span>

            <span>
              Ver descripción
            </span>

            <span>→</span>
          `;


        descriptionButton.addEventListener(
          "click",
          () => {

            abrirDescripcion(
              propiedad
            );

          }
        );


        content.appendChild(
          descriptionButton
        );

      }


      /*
       * WHATSAPP
       */

      const actions =
        document.createElement(
          "div"
        );


      actions.className =
        "property-actions";


      const button =
        document.createElement(
          "button"
        );


      button.type =
        "button";


      button.className =
        "whatsapp-button";


      button.innerHTML =
        `
          <span>💬</span>

          <span>
            Consultar por WhatsApp
          </span>
        `;


      button.addEventListener(
        "click",
        () => {

          abrirWhatsApp(
            propiedad
          );

        }
      );


      actions.appendChild(
        button
      );


      content.appendChild(
        actions
      );


      card.appendChild(
        content
      );


      return card;

    }


    /* =========================================================
       DESCRIPCIÓN
    ========================================================= */

    function abrirDescripcion(
      propiedad
    ) {

      if (
        !propiedad ||
        !propiedad.descripcion
      ) {

        return;

      }


      state.description.property =
        propiedad;


      state.description.scrollPosition =
        window.scrollY;


      state.description.open =
        true;


      elements.descriptionModalTitle
        .textContent =
        propiedad.ambientes
          ? (
              normalizarTexto(
                propiedad.ambientes
              ).includes(
                "amb"
              )
                ? propiedad.ambientes
                : `${propiedad.ambientes} ambientes`
            )
          : "Departamento";


      const ubicacion = [];


      if (
        propiedad.barrio
      ) {

        ubicacion.push(
          propiedad.barrio
        );

      }


      if (
        propiedad.direccion
      ) {

        ubicacion.push(
          propiedad.direccion
        );

      }


      elements.descriptionModalLocation
        .textContent =
        ubicacion.join(
          " · "
        );


      elements.descriptionModalText
        .textContent =
        propiedad.descripcion;


      /*
       * HISTORIAL
       */

      history.pushState(
        {
          description: true
        },
        "",
        "#descripcion"
      );


      document.body.classList.add(
        "modal-open"
      );


      elements.descriptionModal
        .classList.add(
          "active"
        );


      elements.descriptionModal
        .setAttribute(
          "aria-hidden",
          "false"
        );

    }


    function cerrarDescripcion(
      usarHistorial = true
    ) {

      if (
        !state.description.open
      ) {

        return;

      }


      state.description.open =
        false;


      state.description.property =
        null;


      document.body.classList.remove(
        "modal-open"
      );


      elements.descriptionModal
        .classList.remove(
          "active"
        );


      elements.descriptionModal
        .setAttribute(
          "aria-hidden",
          "true"
        );


      if (
        usarHistorial &&
        location.hash ===
        "#descripcion"
      ) {

        history.back();

      }


      requestAnimationFrame(
        () => {

          window.scrollTo(
            0,
            state.description.scrollPosition
          );

        }
      );

    }


    /* =========================================================
       EMPTY
    ========================================================= */

    function mostrarEmpty() {

      elements.propertiesContainer
        .innerHTML =
        `
          <div class="empty-state">

            <div class="empty-icon">
              🔎
            </div>

            <div class="empty-title">
              No encontramos departamentos
            </div>

            <div class="empty-text">
              Probá modificando alguno
              de los filtros.
            </div>

            <button
              id="emptyClearButton"
              class="clear-filters"
              type="button"
            >
              Limpiar filtros
            </button>

          </div>
        `;


      document
        .getElementById(
          "emptyClearButton"
        )
        ?.addEventListener(
          "click",
          limpiarFiltros
        );

    }


    /* =========================================================
       LOADING
    ========================================================= */

    function mostrarLoading() {

      elements.propertiesContainer
        .innerHTML =
        `
          <div class="loading">

            <div class="spinner"></div>

            <div>
              Cargando departamentos...
            </div>

          </div>
        `;

    }


    /* =========================================================
       ERROR
    ========================================================= */

    function mostrarError() {

      elements.propertiesContainer
        .innerHTML =
        `
          <div class="error-state">

            <div
              style="
                font-size:38px;
                margin-bottom:12px;
              "
            >
              ⚠️
            </div>

            <strong>
              No pudimos cargar
              los departamentos.
            </strong>

            <p style="margin-top:8px;">
              Revisá que la planilla
              esté publicada correctamente
              como CSV.
            </p>

            <button
              class="retry-button"
              onclick="location.reload()"
            >
              Reintentar
            </button>

          </div>
        `;


      elements.resultsCount.textContent =
        "No se pudieron cargar las propiedades";

    }


    /* =========================================================
       LIMPIAR FILTROS
    ========================================================= */

    function limpiarFiltros() {

      state.selectedEnvironment =
        "";

      state.neighborhood =
        "";

      state.dog =
        false;

      state.cat =
        false;

      state.laundry =
        false;


      elements.neighborhoodSelect.value =
        "";


      elements.filterDog
        .classList.remove(
          "active"
        );


      elements.filterCat
        .classList.remove(
          "active"
        );


      elements.filterLaundry
        .classList.remove(
          "active"
        );


      actualizarBotonesAmbientes();

      aplicarFiltros();

    }


    /* =========================================================
       EVENTOS FILTROS
    ========================================================= */

    elements.neighborhoodSelect
      .addEventListener(
        "change",
        event => {

          state.neighborhood =
            event.target.value;


          aplicarFiltros();

        }
      );


    elements.filterDog
      .addEventListener(
        "click",
        () => {

          state.dog =
            !state.dog;


          elements.filterDog
            .classList.toggle(
              "active",
              state.dog
            );


          aplicarFiltros();

        }
      );


    elements.filterCat
      .addEventListener(
        "click",
        () => {

          state.cat =
            !state.cat;


          elements.filterCat
            .classList.toggle(
              "active",
              state.cat
            );


          aplicarFiltros();

        }
      );


    elements.filterLaundry
      .addEventListener(
        "click",
        () => {

          state.laundry =
            !state.laundry;


          elements.filterLaundry
            .classList.toggle(
              "active",
              state.laundry
            );


          aplicarFiltros();

        }
      );


    elements.clearFilters
      .addEventListener(
        "click",
        limpiarFiltros
      );


    /* =========================================================
       GALERÍA
    ========================================================= */

    function abrirGaleria(
      fotos,
      indice = 0
    ) {

      if (
        !fotos ||
        fotos.length === 0
      ) {

        return;

      }


      state.gallery.images =
        fotos;


      state.gallery.index =
        indice;


      state.gallery.scrollPosition =
        window.scrollY;


      state.gallery.open =
        true;


      history.pushState(
        {
          gallery: true
        },
        "",
        "#galeria"
      );


      document.body.classList.add(
        "modal-open"
      );


      elements.gallery
        .classList.add(
          "active"
        );


      elements.gallery
        .setAttribute(
          "aria-hidden",
          "false"
        );


      actualizarGaleria();

    }


    function cerrarGaleria(
      usarHistorial = true
    ) {

      if (
        !state.gallery.open
      ) {

        return;

      }


      state.gallery.open =
        false;


      document.body.classList.remove(
        "modal-open"
      );


      elements.gallery
        .classList.remove(
          "active"
        );


      elements.gallery
        .setAttribute(
          "aria-hidden",
          "true"
        );


      if (
        usarHistorial &&
        location.hash ===
        "#galeria"
      ) {

        history.back();

      }


      requestAnimationFrame(
        () => {

          window.scrollTo(
            0,
            state.gallery.scrollPosition
          );

        }
      );

    }


    function actualizarGaleria() {

      const fotos =
        state.gallery.images;


      const indice =
        state.gallery.index;


      if (
        !fotos.length
      ) {

        return;

      }


      elements.galleryImage.src =
        fotos[indice];


      elements.galleryImage.alt =
        `Foto ${
          indice + 1
        } del departamento`;


      elements.galleryCounter.textContent =
        `${
          indice + 1
        } / ${
          fotos.length
        }`;


      elements.galleryPrev.style.display =
        fotos.length > 1
          ? "block"
          : "none";


      elements.galleryNext.style.display =
        fotos.length > 1
          ? "block"
          : "none";

    }


    function fotoAnterior() {

      const cantidad =
        state.gallery.images.length;


      if (
        cantidad <= 1
      ) {

        return;

      }


      state.gallery.index =
        (
          state.gallery.index -
          1 +
          cantidad
        ) %
        cantidad;


      actualizarGaleria();

    }


    function fotoSiguiente() {

      const cantidad =
        state.gallery.images.length;


      if (
        cantidad <= 1
      ) {

        return;

      }


      state.gallery.index =
        (
          state.gallery.index +
          1
        ) %
        cantidad;


      actualizarGaleria();

    }


    /* =========================================================
       EVENTOS GALERÍA
    ========================================================= */

    elements.galleryClose
      .addEventListener(
        "click",
        () => {

          cerrarGaleria(true);

        }
      );


    elements.galleryPrev
      .addEventListener(
        "click",
        fotoAnterior
      );


    elements.galleryNext
      .addEventListener(
        "click",
        fotoSiguiente
      );


    elements.gallery
      .addEventListener(
        "click",
        event => {

          if (
            event.target ===
            elements.gallery
          ) {

            cerrarGaleria(true);

          }

        }
      );


    /* =========================================================
       DESCRIPTION EVENTS
    ========================================================= */

    elements.descriptionClose
      .addEventListener(
        "click",
        () => {

          cerrarDescripcion(true);

        }
      );


    elements.descriptionModal
      .addEventListener(
        "click",
        event => {

          if (
            event.target ===
            elements.descriptionModal
          ) {

            cerrarDescripcion(true);

          }

        }
      );


    /* =========================================================
       TECLADO
    ========================================================= */

    document.addEventListener(
      "keydown",
      event => {

        /*
         * DESCRIPCIÓN
         */

        if (
          state.description.open
        ) {

          if (
            event.key ===
            "Escape"
          ) {

            cerrarDescripcion(true);

          }

          return;

        }


        /*
         * GALERÍA
         */

        if (
          !state.gallery.open
        ) {

          return;

        }


        if (
          event.key ===
          "Escape"
        ) {

          cerrarGaleria(true);

        }


        if (
          event.key ===
          "ArrowLeft"
        ) {

          fotoAnterior();

        }


        if (
          event.key ===
          "ArrowRight"
        ) {

          fotoSiguiente();

        }

      }
    );


    /* =========================================================
       BOTÓN ATRÁS
    ========================================================= */

    window.addEventListener(
      "popstate",
      () => {

        if (
          state.gallery.open
        ) {

          cerrarGaleria(false);

          return;

        }


        if (
          state.description.open
        ) {

          cerrarDescripcion(false);

          return;

        }

      }
    );


    /* =========================================================
       SWIPE GALERÍA
    ========================================================= */

    let touchStartX =
      0;


    let touchEndX =
      0;


    elements.gallery
      .addEventListener(
        "touchstart",
        event => {

          touchStartX =
            event.changedTouches[0]
              .screenX;

        },
        {
          passive: true
        }
      );


    elements.gallery
      .addEventListener(
        "touchend",
        event => {

          touchEndX =
            event.changedTouches[0]
              .screenX;


          const diferencia =
            touchEndX -
            touchStartX;


          if (
            Math.abs(
              diferencia
            ) < 50
          ) {

            return;

          }


          if (
            diferencia > 0
          ) {

            fotoAnterior();

          }

          else {

            fotoSiguiente();

          }

        },
        {
          passive: true
        }
      );


    /* =========================================================
       INICIALIZACIÓN
    ========================================================= */

    async function iniciar() {

      await cargarConfiguracion();

      await cargarPropiedades();

      /*
       * Asignamos data-value
       * después de crear los botones.
       */

      prepararBotonesAmbientes();

    }
 

    iniciar();

  </script>

</body>
