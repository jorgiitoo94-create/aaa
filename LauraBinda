    /* =========================================================
       CARGAR CSV
    ========================================================= */

    async function cargarPropiedades() {

      try {

        mostrarLoading();


        const response =
          await fetch(
            CSV_URL +
            "&t=" +
            Date.now()
          );


        if (!response.ok) {

          throw new Error(
            "No se pudo descargar el CSV"
          );

        }


        const csv =
          await response.text();


        Papa.parse(
          csv,
          {

            header: true,

            skipEmptyLines: true,

            transformHeader:
              header =>
                normalizarClave(
                  header
                ),

            complete:
              resultado => {

                try {

                  procesarPropiedades(
                    resultado.data
                  );

                }

                catch (error) {

                  console.error(
                    error
                  );

                  mostrarError();

                }

              },

            error:
              error => {

                console.error(
                  error
                );

                mostrarError();

              }

          }
        );

      }

      catch (error) {

        console.error(
          "Error cargando CSV:",
          error
        );

        mostrarError();

      }

    }


    /* =========================================================
       PROCESAR PROPIEDADES
    ========================================================= */

    function procesarPropiedades(
      propiedades
    ) {

      state.properties =
        propiedades

          .filter(
            propiedad =>
              Object.values(
                propiedad
              ).some(
                valor =>
                  String(
                    valor || ""
                  ).trim() !== ""
              )
          )

          .map(
            propiedad => {

              return {

                raw:
                  propiedad,

                fotos:
                  obtenerFotos(
                    propiedad
                  ),

                ambientes:
                  obtenerCampo(
                    propiedad,
                    [
                      "ambientes"
                    ]
                  ),

                barrio:
                  obtenerCampo(
                    propiedad,
                    [
                      "barrio"
                    ]
                  ),

                direccion:
                  obtenerCampo(
                    propiedad,
                    [
                      "direccion"
                    ]
                  ),

                valor:
                  obtenerCampo(
                    propiedad,
                    [
                      "valor",
                      "precio"
                    ]
                  ),

                expensas:
                  obtenerCampo(
                    propiedad,
                    [
                      "expensas"
                    ]
                  ),

                gastos:
                  obtenerCampo(
                    propiedad,
                    [
                      "gastos"
                    ]
                  ),

                perro:
                  obtenerCampo(
                    propiedad,
                    [
                      "perro"
                    ]
                  ),

                gato:
                  obtenerCampo(
                    propiedad,
                    [
                      "gato"
                    ]
                  ),

