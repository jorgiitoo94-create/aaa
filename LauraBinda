    /* =========================================================
       NORMALIZAR TEXTO
    ========================================================= */

    function normalizarTexto(valor) {

      if (
        valor === null ||
        valor === undefined
      ) {

        return "";

      }


      return String(valor)

        .trim()

        .toLowerCase()

        .normalize("NFD")

        .replace(
          /[\u0300-\u036f]/g,
          ""
        );

    }


    /* =========================================================
       NORMALIZAR CLAVE
    ========================================================= */

    function normalizarClave(valor) {

      return normalizarTexto(valor)

        .replace(
          /[^a-z0-9]/g,
          ""
        );

    }


    /* =========================================================
       OBTENER CAMPO
    ========================================================= */

    function obtenerCampo(
      propiedad,
      nombres
    ) {

      for (
        const nombre of nombres
      ) {

        const clave =
          normalizarClave(nombre);


        if (
          Object.prototype.hasOwnProperty.call(
            propiedad,
            clave
          )
        ) {

          const valor =
            propiedad[clave];


          if (
            valor !== null &&
            valor !== undefined &&
            String(valor).trim() !== ""
          ) {

            return String(valor).trim();

          }

        }

      }


      return "";

    }


    /* =========================================================
       VERDADERO
    ========================================================= */

    function esVerdadero(valor) {

      const texto =
        normalizarTexto(valor);


      if (!texto) {

        return false;

      }


      return [

        "si",
        "yes",
        "true",
        "1",
        "apto",
        "acepta",
        "permitido",
        "permitida",
        "incluido",
        "incluida",
        "disponible"

      ].includes(texto);

    }


    /* =========================================================
       DRIVE
    ========================================================= */

    function extraerDriveId(url) {

      if (!url) {

        return "";

      }


      const texto =
        String(url).trim();


      let match =
        texto.match(
          /\/file\/d\/([a-zA-Z0-9_-]+)/
        );


      if (match) {

        return match[1];

      }


      match =
        texto.match(
          /[?&]id=([a-zA-Z0-9_-]+)/
        );


      if (match) {

        return match[1];

      }


      match =
        texto.match(
          /\/d\/([a-zA-Z0-9_-]+)/
        );


      if (match) {

        return match[1];

      }


      if (
        /^[a-zA-Z0-9_-]{20,}$/.test(
          texto
        )
      ) {

        return texto;

      }


      return "";

    }


    function convertirImagenDrive(url) {

      if (!url) {

        return "";

      }


      const id =
        extraerDriveId(url);


      if (!id) {

        return url;

      }


      return (
        "https://drive.google.com/thumbnail" +
        "?id=" +
        encodeURIComponent(id) +
        "&sz=w1200"
      );

    }


    /* =========================================================
       FOTOS
    ========================================================= */

    function obtenerFotos(propiedad) {

      const fotos = [];


      Object.keys(propiedad)

        .filter(
          clave =>
            clave === "fotos" ||
            /^fotos\d+$/.test(clave)
        )

        .sort(
          (a, b) => {

            if (a === "fotos") {

              return -1;

            }


            if (b === "fotos") {

              return 1;

            }


            const na =
              parseInt(
                a.replace(
                  "fotos",
                  ""
                )
              ) || 0;


            const nb =
              parseInt(
                b.replace(
                  "fotos",
                  ""
                )
              ) || 0;


            return na - nb;

          }
        )

        .forEach(
          clave => {

            const valor =
              propiedad[clave];


            if (!valor) {

              return;

            }


            const urls =
              String(valor)

                .split(
                  /\s*,\s*|\n+/
                )

                .map(
                  x => x.trim()
                )

                .filter(Boolean);


            urls.forEach(
              url => {

                const imagen =
                  convertirImagenDrive(
                    url
                  );


                if (
                  imagen &&
                  !fotos.includes(
                    imagen
                  )
                ) {

                  fotos.push(
                    imagen
                  );

                }

              }
            );

          }
        );


      return fotos;

    }


    /* =========================================================
       ESCAPAR HTML
    ========================================================= */

    function escaparHTML(valor) {

      return String(
        valor ?? ""
      )

        .replace(
          /&/g,
          "&amp;"
        )

        .replace(
          /</g,
          "&lt;"
        )

        .replace(
          />/g,
          "&gt;"
        )

        .replace(
          /"/g,
          "&quot;"
        )

        .replace(
          /'/g,
          "&#039;"
        );

    }


    /* =========================================================
