<script>


/* =========================================================
   CONFIGURACION
========================================================= */

const URL_CSV =
"https://docs.google.com/spreadsheets/d/e/2PACX-1vQ2E7ECUfY-ps4Ok0_1TJxTR1UPoYl-_ZYkGNlvhk9eZWHBslhsWtoCiTaPfCjQJ38kojq9pJBeoGep/pub?output=csv";


/*
   Número general de WhatsApp.
   CAMBIAR por tu número.
*/

const WHATSAPP_GENERAL =
"549XXXXXXXXXX";


/* =========================================================
   VARIABLES
========================================================= */

let departamentos = [];

let ambientesSeleccionados = [];

let mascotasSeleccionadas = [];

let barriosSeleccionados = [];

let fotosGaleria = [];

let indiceFoto = 0;

let modalAbierto = false;


/* =========================================================
   OBTENER TODAS LAS FOTOS
========================================================= */

function obtenerFotos(row){

    /*
       Columnas reales del Google Sheet
    */

    const columnasFotos = [
        "Fotos",
        "Fotos2",
        "Fotos3"
    ];


    let todasLasFotos = [];


    /*
       Buscar columna ignorando mayúsculas/minúsculas
    */

    function obtenerColumna(nombre){

        const clave =
            Object.keys(row).find(function(k){

                return k.trim().toLowerCase() ===
                       nombre.trim().toLowerCase();

            });


        return clave ? row[clave] : "";

    }


    /*
       Convertir enlaces de Google Drive
    */

    function convertirDrive(url){

        url = url.trim();


        /*
           Extraer ID de:

           drive.google.com/open?id=XXXX

           drive.google.com/file/d/XXXX/view

           drive.google.com/uc?id=XXXX
        */

        let match =
            url.match(/[?&]id=([a-zA-Z0-9_-]+)/);


        if(!match){

            match =
                url.match(
                    /\/file\/d\/([a-zA-Z0-9_-]+)/
                );

        }


        if(!match){

            match =
                url.match(
                    /\/d\/([a-zA-Z0-9_-]+)/
                );

        }


        /*
           Si encontramos ID
        */

        if(match){

            const id =
                match[1];


            return (
                "https://drive.google.com/thumbnail?id=" +
                id +
                "&sz=w1600"
            );

        }


        return url;

    }


    /*
       Recorrer Fotos, Fotos2 y Fotos3
    */

    columnasFotos.forEach(function(columna){

        const contenido =
            obtenerColumna(columna);


        if(!contenido){

            return;

        }


        const texto =
            String(contenido).trim();


        if(!texto){

            return;

        }


        /*
           Extraer URLs.

           Funciona también cuando
           están dentro de:

           [URL](URL)
        */

        const urls =
            texto.match(
                /https?:\/\/[^\s\])"']+/g
            );


        if(!urls){

            return;

        }


        urls.forEach(function(url){

            url =
                url.trim();


            /*
               Limpiar caracteres
               finales.
            */

            url =
                url.replace(
                    /[),.;]+$/,
                    ""
                );


            const foto =
                convertirDrive(url);


            /*
               Evitar duplicados
            */

            if(
                foto &&
                !todasLasFotos.includes(foto)
            ){

                todasLasFotos.push(foto);

            }

        });

    });


    console.log(
        "Fotos encontradas:",
        todasLasFotos
    );


    return todasLasFotos;

}


/* =========================================================
   CARGAR CSV
========================================================= */

Papa.parse(
    URL_CSV,
    {

        download:true,

        header:true,

        skipEmptyLines:true,

        complete:function(results){

            console.log(
                "CSV cargado:",
                results.data
            );


            departamentos =
                results.data.filter(function(row){

                    return (
                        obtenerCelda(row,"Dirección") ||
                        obtenerCelda(row,"direccion")
                    );

                });


            prepararFiltros();

            renderizar();

        },

        error:function(error){

            console.error(
                "Error cargando CSV:",
                error
            );


            document.getElementById(
                "departamentos"
            ).innerHTML = `
                <div class="sin-resultados">
                    No se pudieron cargar los departamentos.
                </div>
            `;

        }

    }
);


/* =========================================================
   OBTENER CELDA
========================================================= */

function obtenerCelda(row,nombre){

    const clave =
        Object.keys(row).find(function(k){

            return k.trim().toLowerCase() ===
                   nombre.trim().toLowerCase();

        });


    return clave
        ? String(row[clave] || "").trim()
        : "";

}


/* =========================================================
   PREPARAR FILTROS
========================================================= */

function prepararFiltros(){

    const ambientes = [];


    departamentos.forEach(function(row){

        const ambiente =
            obtenerCelda(row,"Ambientes");


        if(
            ambiente &&
            !ambientes.includes(ambiente)
        ){

            ambientes.push(ambiente);

        }

    });


    ambientes.sort(function(a,b){

        return parseInt(a) - parseInt(b);

    });


    const contenedor =
        document.getElementById(
            "filtroAmbientes"
        );


    contenedor.innerHTML = "";


    ambientes.forEach(function(ambiente){

        const numero =
            parseInt(ambiente);


        const texto =
            numero === 1
                ? "1 ambiente"
                : numero + " ambientes";


        const boton =
            document.createElement("button");


        boton.className =
            "filtro-btn";


        boton.textContent =
            texto;


        boton.dataset.ambiente =
            ambiente;


        boton.onclick =
            function(){

                toggleAmbiente(
                    ambiente,
                    boton
                );

            };


        contenedor.appendChild(
            boton
        );

    });


    /*
       Barrios
    */

    const barrios = [];


    departamentos.forEach(function(row){

        const barrio =
            obtenerCelda(row,"barrio");


        if(
            barrio &&
            !barrios.includes(barrio)
        ){

            barrios.push(barrio);

        }

    });


    barrios.sort();


    const select =
        document.getElementById(
            "barrioSelect"
        );


    barrios.forEach(function(barrio){

        const option =
            document.createElement("option");


        option.value =
            barrio;


        option.textContent =
            barrio;


        select.appendChild(
            option
        );

    });

}


/* =========================================================
   TOGGLE AMBIENTE
========================================================= */

function toggleAmbiente(
    ambiente,
    boton
){

    const indice =
        ambientesSeleccionados.indexOf(
            ambiente
        );


    if(indice === -1){

        ambientesSeleccionados.push(
            ambiente
        );

        boton.classList.add(
            "activo"
        );

    }else{

        ambientesSeleccionados.splice(
            indice,
            1
        );

        boton.classList.remove(
            "activo"
        );

    }


    renderizar();

}


/* =========================================================
   TOGGLE MASCOTA
========================================================= */

function toggleMascota(tipo){

    const indice =
        mascotasSeleccionadas.indexOf(
            tipo
        );


    const boton =
        document.querySelector(
            `[data-mascota="${tipo}"]`
        );


    if(indice === -1){

        mascotasSeleccionadas.push(
            tipo
        );

        boton.classList.add(
            "activo"
        );

    }else{

        mascotasSeleccionadas.splice(
            indice,
            1
        );

        boton.classList.remove(
            "activo"
        );

    }


    renderizar();

}


/* =========================================================
   AGREGAR BARRIO
========================================================= */

function agregarBarrio(barrio){

    if(!barrio){

        return;

    }


    if(
        !barriosSeleccionados.includes(
            barrio
        )
    ){

        barriosSeleccionados.push(
            barrio
        );

    }


    document.getElementById(
        "barrioSelect"
    ).value = "";


    renderizarBarrios();

    renderizar();

}


/* =========================================================
   MOSTRAR BARRIOS
========================================================= */

function renderizarBarrios(){

    const contenedor =
        document.getElementById(
            "barriosSeleccionados"
        );


    contenedor.innerHTML = "";


    barriosSeleccionados.forEach(function(barrio){

        const tag =
            document.createElement("div");


        tag.className =
            "barrio-tag";


        tag.innerHTML = `
            <span>${escapeHTML(barrio)}</span>
            <button
                onclick="quitarBarrio(${JSON.stringify(barrio)})"
            >
                ×
            </button>
        `;


        contenedor.appendChild(
            tag
        );

    });

}


/* =========================================================
   QUITAR BARRIO
========================================================= */

function quitarBarrio(barrio){

    barriosSeleccionados =
        barriosSeleccionados.filter(
            function(b){
                return b !== barrio;
            }
        );


    renderizarBarrios();

    renderizar();

}


/* =========================================================
   FILTRAR
========================================================= */

function obtenerDepartamentosFiltrados(){

    return departamentos.filter(function(row){

        /*
           AMBIENTES
        */

        if(
            ambientesSeleccionados.length > 0
        ){

            const ambiente =
                obtenerCelda(
                    row,
                    "Ambientes"
                );


            if(
                !ambientesSeleccionados.includes(
                    ambiente
                )
            ){

                return false;

            }

        }


        /*
           BARRIOS
        */

        if(
            barriosSeleccionados.length > 0
        ){

            const barrio =
                obtenerCelda(
                    row,
                    "barrio"
                );


            if(
                !barriosSeleccionados.includes(
                    barrio
                )
            ){

                return false;

            }

        }


        /*
           MASCOTAS
        */

        if(
            mascotasSeleccionadas.length > 0
        ){

            const perro =
                obtenerCelda(
                    row,
                    "perro?"
                ).toLowerCase();


            const gato =
                obtenerCelda(
                    row,
                    "gato?"
                ).toLowerCase();


            let acepta = false;


            if(
                mascotasSeleccionadas.includes(
                    "perro"
                ) &&
                (
                    perro === "si" ||
                    perro === "sí"
                )
            ){

                acepta = true;

            }


            if(
                mascotasSeleccionadas.includes(
                    "gato"
                ) &&
                (
                    gato === "si" ||
                    gato === "sí"
                )
            ){

                acepta = true;

            }


            if(!acepta){

                return false;

            }

        }


        return true;

    });

}


/* =========================================================
   RENDERIZAR
========================================================= */

function renderizar(){

    const contenedor =
        document.getElementById(
            "departamentos"
        );


    const lista =
        obtenerDepartamentosFiltrados();


    document.getElementById(
        "resultadosInfo"
    ).textContent =
        lista.length +
        (
            lista.length === 1
                ? " departamento encontrado"
                : " departamentos encontrados"
        );


    if(lista.length === 0){

        contenedor.innerHTML = `
            <div class="sin-resultados">
                No encontramos departamentos
                con esos filtros.
            </div>
        `;

        return;

    }


    contenedor.innerHTML = "";


    lista.forEach(function(row){

        contenedor.appendChild(
            crearCard(row)
        );

    });

}


/* =========================================================
   CREAR CARD
========================================================= */

function crearCard(row){

    const card =
        document.createElement("article");


    card.className =
        "card";


    const fotos =
        obtenerFotos(row);


    const primeraFoto =
        fotos.length > 0
            ? fotos[0]
            : "";


    const barrio =
        obtenerCelda(
            row,
            "barrio"
        );


    const direccion =
        obtenerCelda(
            row,
            "Dirección"
        );


    const ambientes =
        obtenerCelda(
            row,
            "Ambientes"
        );


    const valor =
        obtenerCelda(
            row,
            "Valor:"
        );


    const incluye =
        obtenerCelda(
            row,
            "Incluye"
        );


    const perro =
        obtenerCelda(
            row,
            "perro?"
        ).toLowerCase();


    const gato =
        obtenerCelda(
            row,
            "gato?"
        ).toLowerCase();


    const descripcion =
        obtenerCelda(
            row,
            "descripcion"
        ) ||
        obtenerCelda(
            row,
            "DescripcioN"
        );


    const textoAmbientes =
        parseInt(ambientes) === 1
            ? "1 ambiente"
            : ambientes + " ambientes";


    let imagenHTML;


    if(primeraFoto){

        imagenHTML = `
            <img
                class="card-imagen"
                src="${escapeHTML(primeraFoto)}"
                alt="${escapeHTML(direccion)}"
                loading="lazy"
                onclick="abrirGaleriaDesdeCard(this)"
                data-fotos='${escapeHTML(JSON.stringify(fotos))}'
                onerror="imagenFallida(this)"
            >
        `;

    }else{

        imagenHTML = `
            <div class="imagen-error">
                Sin foto
            </div>
        `;

    }


    let mascotasHTML = "";


    if(
        perro === "si" ||
        perro === "sí"
    ){

        mascotasHTML += `
            <span class="mascota">
                🐶 Perro
            </span>
        `;

    }


    if(
        gato === "si" ||
        gato === "sí"
    ){

        mascotasHTML += `
            <span class="mascota">
                🐱 Gato
            </span>
        `;

    }


    card.innerHTML = `

        ${imagenHTML}

        <div class="card-contenido">

            <div class="card-barrio">
                ${escapeHTML(barrio)}
            </div>

            <h2>
                ${escapeHTML(textoAmbientes)}
            </h2>

            <div class="card-direccion">
                📍 ${escapeHTML(direccion)}
            </div>

            <div class="card-valor">
                💰 ${escapeHTML(valor)}
            </div>

            ${
                incluye
                ?
                `
                <div class="card-incluye">
                    ${escapeHTML(incluye)}
                </div>
                `
                :
                ""
            }

            ${
                mascotasHTML
                ?
                `<div class="mascotas">
                    ${mascotasHTML}
                </div>`
                :
                ""
            }


            <div class="card-botones">

                <button
                    class="card-btn btn-fotos"
                    onclick='abrirGaleria(${JSON.stringify(fotos)})'
                >
                    📸 Fotos
                </button>


                <button
                    class="card-btn btn-descripcion"
                    onclick='abrirDescripcion(${JSON.stringify(
                        descripcion
                    )},${JSON.stringify(
                        direccion
                    )})'
                >
                    📋 Descripción
                </button>


                <button
                    class="card-btn btn-contacto"
                    onclick='contactarWhatsApp(${JSON.stringify(
                        row
                    )})'
                >
                    💬 Contacto
                </button>

            </div>

        </div>

    `;


    return card;

}


/* =========================================================
   IMAGEN FALLIDA
========================================================= */

function imagenFallida(img){

    img.onerror = null;

    img.style.display =
        "none";


    const contenedor =
        img.parentElement;


    const placeholder =
        document.createElement(
            "div"
        );


    placeholder.className =
        "imagen-error";


    placeholder.textContent =
        "Imagen no disponible";


    contenedor.insertBefore(
        placeholder,
        img
    );

}


/* =========================================================
   GALERIA DESDE CARD
========================================================= */

function abrirGaleriaDesdeCard(img){

    try{

        const fotos =
            JSON.parse(
                img.dataset.fotos
            );


        abrirGaleria(fotos);

    }catch(error){

        console.error(error);

    }

}


/* =========================================================
   ABRIR GALERIA
========================================================= */

function abrirGaleria(fotos){

    if(
        !fotos ||
        fotos.length === 0
    ){

        return;

    }


    fotosGaleria =
        fotos;


    indiceFoto = 0;


    modalAbierto = true;


    history.pushState(
        {
            modal:true
        },
        ""
    );


    document.getElementById(
        "modalGaleria"
    ).classList.add(
        "activo"
    );


    mostrarFoto();

}


/* =========================================================
   MOSTRAR FOTO
========================================================= */

function mostrarFoto(){

    if(
        fotosGaleria.length === 0
    ){

        return;

    }


    const imagen =
        document.getElementById(
            "imagenGaleria"
        );


    imagen.src =
        fotosGaleria[indiceFoto];


    imagen.alt =
        "Foto " +
        (indiceFoto + 1);


    document.getElementById(
        "contadorFotos"
    ).textContent =
        (indiceFoto + 1) +
        " / " +
        fotosGaleria.length;

}


/* =========================================================
   FOTO ANTERIOR
========================================================= */

function fotoAnterior(){

    if(
        fotosGaleria.length === 0
    ){

        return;

    }


    indiceFoto--;


    if(
        indiceFoto < 0
    ){

        indiceFoto =
            fotosGaleria.length - 1;

    }


    mostrarFoto();

}


/* =========================================================
   FOTO SIGUIENTE
========================================================= */

function fotoSiguiente(){

    if(
        fotosGaleria.length === 0
    ){

        return;

    }


    indiceFoto++;


    if(
        indiceFoto >=
        fotosGaleria.length
    ){

        indiceFoto = 0;

    }


    mostrarFoto();

}


/* =========================================================
   DESCRIPCION
========================================================= */

function abrirDescripcion(
    descripcion,
    direccion
){

    modalAbierto = true;


    history.pushState(
        {
            modal:true
        },
        ""
    );


    document.getElementById(
        "descripcionTitulo"
    ).textContent =
        direccion ||
        "Departamento";


    document.getElementById(
        "descripcionTexto"
    ).textContent =
        descripcion ||
        "No hay descripción disponible.";


    document.getElementById(
        "modalDescripcion"
    ).classList.add(
        "activo"
    );

}


/* =========================================================
   FORMULARIO GENERAL
========================================================= */

function abrirFormulario(){

    modalAbierto = true;


    history.pushState(
        {
            modal:true
        },
        ""
    );


    document.getElementById(
        "modalFormulario"
    ).classList.add(
        "activo"
    );

}


/* =========================================================
   CERRAR MODAL
========================================================= */

function cerrarModal(){

    if(
        modalAbierto
    ){

        history.back();

    }else{

        cerrarModalDirectamente();

    }

}


/* =========================================================
   CERRAR MODAL DIRECTAMENTE
========================================================= */

function cerrarModalDirectamente(){

    document
        .querySelectorAll(".modal")
        .forEach(function(modal){

            modal.classList.remove(
                "activo"
            );

        });


    modalAbierto = false;

}


/* =========================================================
   HISTORIAL
========================================================= */

window.addEventListener(
    "popstate",
    function(){

        cerrarModalDirectamente();

    }
);


/* =========================================================
   TECLADO GALERIA
========================================================= */

document.addEventListener(
    "keydown",
    function(event){

        const galeria =
            document.getElementById(
                "modalGaleria"
            );


        if(
            !galeria.classList.contains(
                "activo"
            )
        ){

            return;

        }


        if(
            event.key === "ArrowRight"
        ){

            fotoSiguiente();

        }


        if(
            event.key === "ArrowLeft"
        ){

            fotoAnterior();

        }


        if(
            event.key === "Escape"
        ){

            cerrarModal();

        }

    }
);


/* =========================================================
   CONTACTO WHATSAPP
========================================================= */

function contactarWhatsApp(row){

    const vendedor =
        obtenerCelda(
            row,
            "Vendedor"
        );


    if(!vendedor){

        alert(
            "No hay número de WhatsApp cargado para este departamento."
        );

        return;

    }


    /*
       Limpiar número
    */

    const telefono =
        vendedor.replace(
            /\D/g,
            ""
        );


    const direccion =
        obtenerCelda(
            row,
            "Dirección"
        );


    const ambientes =
        obtenerCelda(
            row,
            "Ambientes"
        );


    const valor =
        obtenerCelda(
            row,
            "Valor:"
        );


    const textoAmbientes =
        parseInt(ambientes) === 1
            ? "1 ambiente"
            : ambientes + " ambientes";


    const mensaje =
`Hola! Me gustaría saber mas sobre este departamento

📍 Dirección:
${direccion || "Consultar"}

🏠 Características:
${textoAmbientes}

💰 Valor:
${valor || "Consultar"}

¡Muchas gracias!`;


    const url =
        "https://wa.me/" +
        telefono +
        "?text=" +
        encodeURIComponent(
            mensaje
        );


    window.open(
        url,
        "_blank"
    );

}


