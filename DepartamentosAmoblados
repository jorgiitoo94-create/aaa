/* =========================================================
   ESCAPE HTML
========================================================= */

function escapeHTML(valor){

    return String(
        valor || ""
    )
    .replace(
        /&/g,
        "&amp;"
    )
    .replace(
        /</g,
        "&lt;"
    )
    .replace(
        />/g,
        "&gt;"
    )
    .replace(
        /"/g,
        "&quot;"
    )
    .replace(
        /'/g,
        "&#039;"
    );

}


/* =========================================================
   CERRAR MODAL AL TOCAR FONDO
========================================================= */

document
    .querySelectorAll(".modal")
    .forEach(function(modal){

        modal.addEventListener(
            "click",
            function(event){

                if(
                    event.target === modal
                ){

                    cerrarModal();

                }

            }
        );

    });


</script>

